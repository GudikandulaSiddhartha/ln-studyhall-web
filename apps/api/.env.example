# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/ln_studyhall"

# ── JWT — generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NO DEFAULT — server will refuse to start if this is missing
JWT_SECRET="replace-with-64-char-random-hex-string"
JWT_EXPIRES_IN="7d"

# ── Admin invite code — use a long random string, not something guessable
# NO DEFAULT — server will refuse to start if this is missing
ADMIN_INVITE_CODE="replace-with-long-random-string-min-16-chars"

# ── Frontend URL (used for CORS)
FRONTEND_URL="http://localhost:3000"

# ── Server port
PORT=4000

# ── Resend email (free tier — https://resend.com — 3,000 emails/month free)
# Get your API key from https://resend.com/api-keys
# If not set, OTPs are logged to console (dev only)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
